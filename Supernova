                <div class="w-7 h-7 rounded-lg bg-indigo-600 text-white flex items-center justify-center shadow-sm">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-slate-900">Standard Reference & Examination Rationale</h4>
                  <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-[11px] font-semibold text-indigo-700 bg-indigo-100/80 border border-indigo-200/80 px-2 py-0.5 rounded">
                      ${q.standard}
                    </span>
                    <span class="text-[11px] font-medium text-slate-500 bg-slate-200/60 px-2 py-0.5 rounded">
                      ${q.topic}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Result Status Pill -->
              <div>
                ${wasCorrect 
                  ? '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300"><svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg> Answered Correctly</span>'
                  : '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-300"><svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg> Review Needed</span>'
                }
              </div>
            </div>

            <!-- Correct Answer Callout -->
            <div class="bg-white rounded-xl border border-emerald-200/90 p-4 mb-3 shadow-xs">
              <div class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-md bg-emerald-600 text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">✓</span>
                <div class="text-xs sm:text-sm">
                  <div class="font-bold text-emerald-950 mb-1 flex items-center gap-2">
                    <span>Keyed Answer: Option ${q.correctAnswer}</span>
                    <span class="font-normal text-emerald-800">“${correctOptText}”</span>
                  </div>
                  <p class="text-slate-700 leading-relaxed font-normal mt-1.5">
                    ${q.rationale}
                  </p>
                </div>
              </div>
            </div>

            <!-- Distractor / Option Analysis -->
            <div class="bg-white rounded-xl border border-slate-200/90 p-4 shadow-xs">
              <div class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-md bg-slate-700 text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">ℹ</span>
                <div class="text-xs sm:text-sm">
                  <div class="font-bold text-slate-900 mb-1">
                    Option & Distractor Analysis
                  </div>
                  <p class="text-slate-600 leading-relaxed font-normal">
                    ${q.distractorNotes}
                  </p>
                </div>
              </div>
            </div>

          </div>
        `;
      }

      return '<div id="card-' + q.id + '" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 relative transition hover:shadow-md">' +
        '<div class="flex items-center justify-between gap-3 mb-4 border-b border-slate-100 pb-3">' +
          '<div class="flex items-center flex-wrap gap-2">' +
            '<span class="text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 px-2.5 py-1 rounded-md font-mono-num">' +
              q.set + ' • #' + q.num +
            '</span>' +
            '<span class="text-xs font-medium text-slate-600 bg-slate-100 px-2.5 py-1 rounded-md">' +
              q.topic +
            '</span>' +
            '<span class="text-xs font-medium text-sky-700 bg-sky-50 border border-sky-200 px-2.5 py-1 rounded-md">' +
              q.standard +
            '</span>' +
          '</div>' +
          '<div class="flex items-center gap-2">' +
            '<button onclick="toggleFlag(\'' + q.id + '\')" title="Flag for review" class="p-1.5 rounded-lg border text-xs font-medium transition ' + (isFlagged ? 'bg-amber-50 border-amber-300 text-amber-700' : 'border-slate-200 text-slate-400 hover:text-slate-600') + '">' +
              '<svg class="w-4 h-4 ' + (isFlagged ? 'fill-amber-500 text-amber-500' : 'fill-none') + '" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>' +
            '</button>' +
            (isAnswered ? '<button onclick="resetAnswer(\'' + q.id + '\')" title="Reset this answer" class="px-2.5 py-1 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-100 transition flex items-center gap-1"><svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg> Reset</button>' : '') +
          '</div>' +
        '</div>' +
        '<div class="text-base sm:text-lg font-semibold text-slate-900 leading-snug mb-5 whitespace-pre-line">' +
          q.question +
        '</div>' +
        '<div class="space-y-3">' +
          optionsHtml +
        '</div>' +
        explanationHtml +
      '</div>';
    }

    function selectOption(id, letter) {
      userAnswers[id] = letter;
      saveState();
      renderQuestions();
    }

    function resetAnswer(id) {
      delete userAnswers[id];
      saveState();
      renderQuestions();
    }

    function toggleFlag(id) {
      if (flaggedQuestions[id]) delete flaggedQuestions[id];
      else flaggedQuestions[id] = true;
      saveState();
      renderQuestions();
    }

    function switchSet(setName) {
      currentSetKey = setName;
      singleIndex = 0;
      document.getElementById('btn-set-at100').className = setName === 'AT-100' ? 'px-3 py-1.5 rounded-md transition-all text-white bg-indigo-600 shadow-sm font-semibold' : 'px-3 py-1.5 rounded-md transition-all text-slate-300 hover:text-white';
      document.getElementById('btn-set-at300').className = setName === 'AT-300' ? 'px-3 py-1.5 rounded-md transition-all text-white bg-indigo-600 shadow-sm font-semibold' : 'px-3 py-1.5 rounded-md transition-all text-slate-300 hover:text-white';
      document.getElementById('btn-set-all').className = setName === 'ALL' ? 'px-3 py-1.5 rounded-md transition-all text-white bg-indigo-600 shadow-sm font-semibold' : 'px-3 py-1.5 rounded-md transition-all text-slate-300 hover:text-white';
      renderQuestions();
    }

    function setFilter(filt) {
      currentFilter = filt;
      singleIndex = 0;
      const tabs = ['all', 'unanswered', 'incorrect', 'correct', 'flagged'];
      tabs.forEach(t => {
        const el = document.getElementById('tab-' + t);
        if (el) {
          if (t === filt) {
            el.className = 'px-2.5 py-1 rounded-md bg-white text-slate-900 shadow-sm transition font-bold';
          } else {
            el.className = 'px-2.5 py-1 rounded-md text-slate-600 hover:text-slate-900 transition';
          }
        }
      });
      renderQuestions();
    }

    function handleSearch(val) {
      searchQuery = val;
      singleIndex = 0;
      renderQuestions();
    }

    function toggleViewMode() {
      viewMode = viewMode === 'single' ? 'list' : 'single';
      document.getElementById('mode-icon').textContent = viewMode === 'single' ? '📄' : '🎯';
      document.getElementById('mode-label').textContent = viewMode === 'single' ? 'Study List View' : 'Single Exam View';
      renderQuestions();
    }

    function nextQuestion() {
      const filtered = getFilteredQuestions();
      if (singleIndex < filtered.length - 1) {
        singleIndex++;
        renderQuestions();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function prevQuestion() {
      if (singleIndex > 0) {
        singleIndex--;
        renderQuestions();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function jumpToNextUnanswered() {
      const filtered = getFilteredQuestions();
      for (let i = 0; i < filtered.length; i++) {
        if (!userAnswers[filtered[i].id]) {
          singleIndex = i;
          renderQuestions();
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }
      }
      alert('All questions in this view have already been answered!');
    }

    function toggleGridModal() {
      const modal = document.getElementById('grid-modal');
      const isHidden = modal.classList.contains('hidden');
      if (isHidden) {
        const allActive = getActiveQuestions();
        const container = document.getElementById('grid-buttons-container');
        container.innerHTML = allActive.map((q, idx) => {
          const ans = userAnswers[q.id];
          const isCorrect = ans && ans === q.correctAnswer;
          const isWrong = ans && ans !== q.correctAnswer;
          const isFlag = !flaggedQuestions[q.id];

          let btnClass = 'h-10 rounded-lg text-xs font-bold font-mono-num flex items-center justify-center transition border relative ';
          if (isCorrect) {
            btnClass += 'bg-emerald-500 text-white border-emerald-600';
          } else if (isWrong) {
            btnClass += 'bg-rose-500 text-white border-rose-600';
          } else {
            btnClass += 'bg-slate-100 text-slate-700 border-slate-200 hover:bg-slate-200';
          }

          return '<button onclick="jumpToQuestion(' + idx + ')" class="' + btnClass + '">' +
            q.num +
            (isFlag ? '<span class="absolute top-1 right-1 w-2 h-2 rounded-full bg-amber-400"></span>' : '') +
          '</button>';
        }).join('');

        modal.classList.remove('hidden');
      } else {
        modal.classList.add('hidden');
      }
    }

    function jumpToQuestion(idx) {
      singleIndex = idx;
      if (viewMode !== 'single') {
        viewMode = 'single';
        document.getElementById('mode-icon').textContent = '📄';
        document.getElementById('mode-label').textContent = 'Study List View';
      }
      toggleGridModal();
      renderQuestions();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function resetCurrentQuiz() {
      if (confirm('Are you sure you want to reset your answers for the current set? You can try again from the beginning.')) {
        const active = getActiveQuestions();
        active.forEach(q => {
          delete userAnswers[q.id];
        });
        saveState();
        renderQuestions();
      }
    }

    window.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT') return;
      if (viewMode === 'single') {
        const filtered = getFilteredQuestions();
        const curQ = filtered[singleIndex];
        if (!curQ) return;

        if (e.key === 'ArrowRight' || e.key === 'n' || e.key === 'N') {
          nextQuestion();
        } else if (e.key === 'ArrowLeft' || e.key === 'p' || e.key === 'P') {
          prevQuestion();
        } else if (['a', 'A', '1'].includes(e.key)) {
          selectOption(curQ.id, 'A');
        } else if (['b', 'B', '2'].includes(e.key)) {
          selectOption(curQ.id, 'B');
        } else if (['c', 'C', '3'].includes(e.key)) {
          selectOption(curQ.id, 'C');
        } else if (['d', 'D', '4'].includes(e.key)) {
          if (curQ.options['D']) selectOption(curQ.id, 'D');
        } else if (e.key.toLowerCase() === 'f') {
          toggleFlag(curQ.id);
        } else if (e.key.toLowerCase() === 'r') {
          resetAnswer(curQ.id);
        }
      }
    });

    renderQuestions();
  </script>
</body>
</html>
