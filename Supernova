    function getActiveQuestions() {
      let list = [];
      if (currentSetKey === 'AT-100') {
        list = [...RAW_QUIZ_DATA.questions['AT-100']];
      } else if (currentSetKey === 'AT-300') {
        list = [...RAW_QUIZ_DATA.questions['AT-300']];
      } else {
        list = [...RAW_QUIZ_DATA.questions['AT-100'], ...RAW_QUIZ_DATA.questions['AT-300']];
      }
      return list;
    }

    function getFilteredQuestions() {
      const allActive = getActiveQuestions();
      return allActive.filter(q => {
        const ans = userAnswers[q.id];
        const isAnswered = ans !== undefined;
        const isCorrect = isAnswered && ans === q.correctAnswer;
        const isFlagged = !!flaggedQuestions[q.id];

        if (currentFilter === 'unanswered' && isAnswered) return false;
        if (currentFilter === 'correct' && !isCorrect) return false;
        if (currentFilter === 'incorrect' && (!isAnswered || isCorrect)) return false;
        if (currentFilter === 'flagged' && !isFlagged) return false;

        if (searchQuery.trim()) {
          const qText = (q.question + ' ' + Object.values(q.options).join(' ') + ' ' + q.standard + ' ' + q.topic).toLowerCase();
          if (!qText.includes(searchQuery.toLowerCase())) return false;
        }

        return true;
      });
    }

    function updateScoreboard() {
      const allActive = getActiveQuestions();
      let correct = 0;
      let incorrect = 0;
      let answered = 0;

      allActive.forEach(q => {
        const a = userAnswers[q.id];
        if (a) {
          answered++;
          if (a === q.correctAnswer) correct++;
          else incorrect++;
        }
      });

      const total = allActive.length;
      const pct = answered > 0 ? Math.round((correct / answered) * 1000) / 10 : 0;

      document.getElementById('stat-correct').textContent = correct;
      document.getElementById('stat-incorrect').textContent = incorrect;
      document.getElementById('stat-answered').textContent = answered;
      document.getElementById('stat-total').textContent = total;
      document.getElementById('score-percent').textContent = pct + '%';

      const progressBar = document.getElementById('progress-bar-fill');
      progressBar.style.width = Math.min(pct, 100) + '%';

      const badge = document.getElementById('pass-fail-badge');
      const container = document.getElementById('score-percentage-container');

      if (answered === 0) {
        badge.className = 'px-2 py-0.5 rounded text-[11px] font-bold tracking-wide bg-slate-100 text-slate-700 border border-slate-300';
        badge.textContent = 'Target: 75% Passing';
        container.className = 'relative w-14 h-14 flex items-center justify-center rounded-2xl bg-slate-100 border border-slate-200 font-mono-num font-extrabold text-lg text-slate-800 shadow-sm';
      } else if (pct >= 75) {
        badge.className = 'px-2 py-0.5 rounded text-[11px] font-bold tracking-wide bg-emerald-100 text-emerald-800 border border-emerald-300';
        badge.textContent = '✓ PASSING (>=75%)';
        container.className = 'relative w-14 h-14 flex items-center justify-center rounded-2xl bg-emerald-50 border border-emerald-400 font-mono-num font-extrabold text-lg text-emerald-700 shadow-sm';
        progressBar.className = 'h-full bg-emerald-500 transition-all duration-300';
      } else {
        badge.className = 'px-2 py-0.5 rounded text-[11px] font-bold tracking-wide bg-rose-100 text-rose-800 border border-rose-300';
        badge.textContent = 'BELOW 75% TARGET (Gap: ' + (75 - pct).toFixed(1) + '%)';
        container.className = 'relative w-14 h-14 flex items-center justify-center rounded-2xl bg-rose-50 border border-rose-300 font-mono-num font-extrabold text-lg text-rose-700 shadow-sm';
        progressBar.className = 'h-full bg-rose-500 transition-all duration-300';
      }
    }

    function renderQuestions() {
      const filtered = getFilteredQuestions();
      const mount = document.getElementById('questions-list');
      const empty = document.getElementById('empty-state');
      const singleNav = document.getElementById('single-nav-bar');

      updateScoreboard();

      if (filtered.length === 0) {
        mount.innerHTML = '';
        empty.classList.remove('hidden');
        singleNav.classList.add('hidden');
        return;
      }
      empty.classList.add('hidden');

      if (viewMode === 'single') {
        singleNav.classList.remove('hidden');
        if (singleIndex >= filtered.length) singleIndex = filtered.length - 1;
        if (singleIndex < 0) singleIndex = 0;

        document.getElementById('current-q-index').textContent = singleIndex + 1;
        document.getElementById('current-q-total').textContent = filtered.length;

        document.getElementById('btn-prev-q').disabled = singleIndex === 0;
        document.getElementById('btn-prev-q').className = singleIndex === 0 ? 'px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-300 cursor-not-allowed' : 'px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-100 transition';
        document.getElementById('btn-next-q').disabled = singleIndex === filtered.length - 1;

        mount.innerHTML = renderQuestionCard(filtered[singleIndex], singleIndex + 1, filtered.length);
      } else {
        singleNav.classList.add('hidden');
        mount.innerHTML = filtered.map((q, idx) => renderQuestionCard(q, idx + 1, filtered.length)).join('');
      }
    }

